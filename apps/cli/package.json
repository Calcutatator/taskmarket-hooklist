{
  "name": "@lucid-agents/taskmarket",
  "version": "1.11.0",
  "type": "module",
  "bin": {
    "taskmarket": "./dist/index.js"
  },
  "prettier": "@taskmarket/prettier-config",
  "dependencies": {
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/fetch": "2.21.0",
    "@xmtp/node-sdk": "^2.0.0",
    "commander": "^12.0.0",
    "viem": "^2.41.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@taskmarket/eslint-config": "workspace:*",
    "@taskmarket/prettier-config": "workspace:*",
    "@taskmarket/shared": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint:check": "eslint src/",
    "lint:write": "eslint src/ --fix",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "smoke:xmtp-live": "tsx scripts/smoke-xmtp-live.ts",
    "smoke:x402-external": "tsx scripts/smoke-external-x402.ts"
  }
}
