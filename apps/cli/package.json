{
  "name": "@stakework/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "stakework": "./bin/stakework.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint:check": "eslint src/",
    "lint:write": "eslint src/ --fix",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@stakework/shared": "workspace:*",
    "@trpc/client": "^11.4.4",
    "commander": "^11.1.0",
    "zod": "^3.22.4",
    "ora": "^8.0.1",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@stakework/eslint-config": "workspace:*",
    "@stakework/prettier-config": "workspace:*",
    "@stakework/tsup-config": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3"
  },
  "prettier": "@stakework/prettier-config"
}
