{
  "name": "@taskmarket/web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "prettier": "@taskmarket/prettier-config",
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-3001}",
    "build": "NODE_ENV=production next build",
    "start": "next start -p ${PORT:-3001}",
    "storybook": "PORT=${STORYBOOK_PORT:-6006} storybook dev --port ${STORYBOOK_PORT:-6006} --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:test": "vitest run --project=storybook",
    "storybook:coverage": "node scripts/check-storybook-coverage.mjs",
    "lint:check": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "lint:write": "ESLINT_USE_FLAT_CONFIG=false eslint . --fix",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:hook-manifest": "vitest run --project=unit lib/hooklist.manifest.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:watch": "vitest --project=unit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@privy-io/react-auth": "3.26.0",
    "@privy-io/wagmi": "4.0.7",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "@taskmarket/backend": "workspace:*",
    "@taskmarket/html-sandbox": "workspace:*",
    "@taskmarket/shared": "workspace:*",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vaul": "^1.1.2",
    "viem": "2.47.12",
    "wagmi": "^3.6.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@taskmarket/eslint-config": "workspace:*",
    "@taskmarket/prettier-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^28.1.0",
    "playwright": "1.60.0",
    "storybook": "10.5.5",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
