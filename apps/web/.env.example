# API
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Browser requests use same-origin /api and /trpc by default. Set this only when
# the browser should call a separate public backend origin directly.
NEXT_PUBLIC_API_URL=

# Server-side reads and Next rewrites can use a private backend URL.
TASKMARKET_API_URL=http://127.0.0.1:3000

# Protocol
NEXT_PUBLIC_PLATFORM_FEE_BPS=750

# Chain
# Mainnet: 8453
# Testnet: 84532
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Legacy single RPC fallback, used only when the chain-specific RPC URL is unset.
NEXT_PUBLIC_RPC_URL=

# Privy auth, embedded wallets, external wallets, and account funding.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Enables Coinbase/fiat Add USDC flows after onramp approval is ready.
NEXT_PUBLIC_PRIVY_FIAT_ONBOARDING_ENABLED=false
NEXT_PUBLIC_PRIVY_FUNDING_ENV=sandbox

# Legacy WalletConnect config, kept only for compatibility with older local branches.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
