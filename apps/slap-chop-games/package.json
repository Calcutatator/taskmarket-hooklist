{
  "name": "@taskmarket/slap-chop-games",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prettier": "@taskmarket/prettier-config",
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-3007}",
    "build": "NODE_ENV=production next build",
    "start": "next start -p ${PORT:-3007}",
    "storybook": "PORT=${STORYBOOK_PORT:-6007} storybook dev --port ${STORYBOOK_PORT:-6007} --no-open",
    "storybook:build": "storybook build --output-dir storybook-static",
    "storybook:test": "vitest run --project=storybook",
    "storybook:coverage": "node scripts/check-storybook-coverage.mjs",
    "lint:check": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "lint:write": "ESLINT_USE_FLAT_CONFIG=false eslint . --fix",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "type-check": "tsc --noEmit",
    "test": "vitest run --project=unit",
    "test:e2e": "playwright test",
    "test:watch": "vitest --project=unit"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.26.0",
    "@taskmarket/html-sandbox": "workspace:*",
    "@taskmarket/shared": "workspace:*",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.5.5",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/addon-vitest": "10.5.5",
    "@storybook/nextjs-vite": "10.5.5",
    "@tailwindcss/postcss": "^4.3.0",
    "@taskmarket/eslint-config": "workspace:*",
    "@taskmarket/prettier-config": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "4.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^28.1.0",
    "playwright": "1.60.0",
    "storybook": "10.5.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
