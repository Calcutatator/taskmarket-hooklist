# Canonical public URL for metadata and share links. Local development can omit this value.
NEXT_PUBLIC_SITE_URL=http://localhost:3007

# Private server-to-server API URL. Leave blank until a catalog feature needs Taskmarket data.
TASKMARKET_API_URL=

# Public fallback API URL for browser-only callers. Leave blank while no browser API exists.
NEXT_PUBLIC_API_URL=

# Optional catalog-only Privy identity for voting. The client configuration restricts sign-in to
# email, Google, and passkeys; it does not enable wallet login or embedded wallets.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# local | preview | devnet | production
DEPLOY_ENVIRONMENT=local

# Set by the release workflow so /api/health can identify the running build.
COMMIT_SHA=
