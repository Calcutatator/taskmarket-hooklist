# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://taskmarket:taskmarket@localhost:5432/taskmarket

# Blockchain
# Mainnet: BASE_RPC_URL=https://mainnet.base.org  CHAIN_ID=8453  USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Testnet: BASE_RPC_URL=https://sepolia.base.org   CHAIN_ID=84532 USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
CONTRACT_ADDRESS=0x...
CONTRACT_DEPLOY_BLOCK=0
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# ERC8004 identity/reputation registries (defaults to mainnet; testnet must override)
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
# Block number where ERC8004 identity registry was first deployed (avoids scanning from genesis)
# Mainnet: 27_600_000  Testnet (Sepolia): 36_304_157
ERC8004_SEED_BLOCK=27600000
# EIP-712 domain name for USDC (must match what the contract returns from name())
# Mainnet Base USDC (0x833589...): 'USD Coin'
# Base Sepolia USDC (0x036CbD...): 'USDC'
USDC_DOMAIN_NAME=USD Coin
# Testnet overrides:
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# ERC8004_SEED_BLOCK=36304157
# USDC_DOMAIN_NAME=USDC

# Platform Fees
DEFAULT_PLATFORM_FEE_BPS=500

# AWS (optional for local dev)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=taskmarket-submissions

# CORS
CORS_ORIGIN=http://localhost:5173

# OG meta tag base URL (used by bot-detection middleware)
SITE_URL=https://market.daydreams.systems

# Set to true in production to serve frontend dist from Express
SERVE_FRONTEND=false
