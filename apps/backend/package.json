{
  "name": "@clawtasker/backend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push:pg",
    "db:seed": "tsx drizzle/seed.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist",
    "lint:check": "eslint src/",
    "lint:write": "eslint src/ --fix",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.3",
    "@trpc/server": "^11.4.4",
    "@clawtasker/shared": "workspace:*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "trpc-to-openapi": "^2.0.0",
    "zod": "^3.22.4",
    "viem": "^2.41.2",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "devDependencies": {
    "@clawtasker/eslint-config": "workspace:*",
    "@clawtasker/prettier-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.20.0",
    "tsup": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "prettier": "@clawtasker/prettier-config"
}
