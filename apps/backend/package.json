{
  "name": "@taskmarket/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf dist",
    "lint:check": "eslint src/",
    "lint:write": "eslint src/ --fix",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "x402-sign": "tsx scripts/x402-sign.ts",
    "smoke:bounty": "tsx scripts/smoke-bounty.ts",
    "smoke:claim": "tsx scripts/smoke-claim.ts",
    "smoke:pitch": "tsx scripts/smoke-pitch.ts",
    "smoke:benchmark": "tsx scripts/smoke-benchmark.ts",
    "smoke:auction": "tsx scripts/smoke-auction.ts",
    "smoke:identity": "tsx scripts/smoke-identity.ts",
    "smoke:agents": "tsx scripts/smoke-agents.ts",
    "smoke:inbox": "tsx scripts/smoke-inbox.ts",
    "smoke:wallet": "tsx scripts/smoke-wallet.ts",
    "smoke:withdraw": "tsx scripts/smoke-withdraw.ts",
    "smoke:xmtp": "tsx scripts/smoke-xmtp.ts",
    "smoke:email": "tsx scripts/smoke-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@taskmarket/shared": "workspace:*",
    "@trpc/server": "^11.4.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "mailparser": "^3.9.3",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.1",
    "postgres": "^3.4.3",
    "smtp-server": "^3.18.1",
    "trpc-to-openapi": "^2.0.0",
    "viem": "^2.41.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@taskmarket/eslint-config": "workspace:*",
    "@taskmarket/prettier-config": "workspace:*",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.11",
    "@types/smtp-server": "^3.5.12",
    "drizzle-kit": "^0.31.9",
    "tsup": "^8.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "prettier": "@taskmarket/prettier-config"
}
