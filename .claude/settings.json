{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ]; then \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-env-setup.sh; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(docs/adr/*.md)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-adr-embodiment.mjs",
            "timeout": 20,
            "statusMessage": "Checking ADR Embodiment claim against computed evidence..."
          },
          {
            "type": "command",
            "if": "Write(docs/adr/*.md)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-adr-embodiment.mjs",
            "timeout": 20,
            "statusMessage": "Checking ADR Embodiment claim against computed evidence..."
          },
          {
            "type": "command",
            "if": "MultiEdit(docs/adr/*.md)",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-adr-embodiment.mjs",
            "timeout": 20,
            "statusMessage": "Checking ADR Embodiment claim against computed evidence..."
          }
        ]
      }
    ]
  }
}
