auto-install-peers=true
# Resolve optional platform packages against the Node version this repo requires
# (see .nvmrc and package.json engines) instead of whatever Node happens to be
# running the pnpm CLI. Some CI runners execute pnpm through its bundled Node 18
# standalone binary, which silently drops native linux-x64-gnu bindings such as
# @tailwindcss/oxide-linux-x64-gnu and @rolldown/binding-linux-x64-gnu.
node-version=24.0.0
