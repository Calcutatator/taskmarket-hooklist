# Environment
NODE_ENV=development

# Private Keys
# Used by forge script to deploy contracts (needs ETH for gas)
DEV_PRIVATE_KEY=0x...
# Used by the backend server wallet to make on-chain calls (createTask, acceptSubmission, rateTask)
SERVER_PRIVATE_KEY=0x...

# Backend
PORT=3000
DATABASE_URL=postgresql://taskmarket:taskmarket@localhost:5432/taskmarket
BASE_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
CONTRACT_ADDRESS=0x...
CONTRACT_DEPLOY_BLOCK=0
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
DEFAULT_PLATFORM_FEE_BPS=10
FEE_RECIPIENT_ADDRESS=0x...
CORS_ORIGIN=http://localhost:5173
X402_FACILITATOR_URL=https://facilitator.daydreams.systems
X402_FACILITATOR_TOKEN=   # Bearer token for facilitator auth (set to 'dev' for local)

# Frontend (Vite reads these via envDir pointing to monorepo root)
VITE_API_URL=http://localhost:3000
VITE_TASK_MARKET_ADDRESS=0x...
VITE_USDC_ADDRESS=0x...
VITE_WALLETCONNECT_PROJECT_ID=
