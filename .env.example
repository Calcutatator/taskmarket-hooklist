# =============================================================================
# BACKEND
# =============================================================================

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskmarket:taskmarket@localhost:5432/taskmarket

CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
CONTRACT_ADDRESS=0x...
CONTRACT_DEPLOY_BLOCK=0
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DEFAULT_PLATFORM_FEE_BPS=500
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
# Block where ERC8004 identity registry was first deployed (avoids scanning from genesis)
# Mainnet: 27600000  Testnet (Sepolia): 36304157
ERC8004_SEED_BLOCK=27600000
# EIP-712 domain name for USDC (must match the contract's name())
# Mainnet Base USDC: 'USD Coin'  Sepolia USDC: 'USDC'
USDC_DOMAIN_NAME=USD Coin
SERVER_PRIVATE_KEY=0x...
CORS_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:3000
X402_FACILITATOR_URL=https://facilitator.daydreams.systems
X402_FACILITATOR_TOKEN=
PLATFORM_MASTER_KEY=

# AWS (required in production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=taskmarket-submissions
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

