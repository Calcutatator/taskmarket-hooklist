# =============================================================================
# CONTRACT DEPLOYMENT (forge scripts only — FORGE_ prefix)
# =============================================================================
#
# Every FORGE_ input below is suffixed _TESTNET / _MAINNET / _PREVIEW -- the
# Makefile's `make deploy <testnet|mainnet|preview>` resolves each as
# FORGE_X, falling back to FORGE_X_TESTNET / FORGE_X_MAINNET / FORGE_X_PREVIEW
# per the target given (same pattern the reward-hook vars below already use).
# ALWAYS set the suffixed form, never the bare form, or a value tuned for one
# network silently carries over into a deploy against a different one.

FORGE_DEV_PRIVATE_KEY_TESTNET=0x...
FORGE_DEV_PRIVATE_KEY_MAINNET=0x...
FORGE_DEV_PRIVATE_KEY_PREVIEW=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80  # Anvil default account #0

FORGE_SERVER_ADDRESS_TESTNET=0x...
FORGE_SERVER_ADDRESS_MAINNET=0x...
FORGE_SERVER_ADDRESS_PREVIEW=0x70997970C51812dc3A010C7d01b50e0d17dc79C8  # Anvil default account #1

FORGE_USDC_TOKEN_ADDRESS_TESTNET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
FORGE_USDC_TOKEN_ADDRESS_MAINNET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# FORGE_USDC_TOKEN_ADDRESS_PREVIEW: not set here -- a fresh disposable chain has no
# USDC deployed, so this is a deploy OUTPUT (packages/contracts/script/
# DeployMockUSDCPreview.s.sol), computed fresh each run, not a static config input.

FORGE_FEE_RECIPIENT_ADDRESS_TESTNET=0x...
FORGE_FEE_RECIPIENT_ADDRESS_MAINNET=0x...
FORGE_FEE_RECIPIENT_ADDRESS_PREVIEW=0x14dC79964da2C08b23698B3D3cc7Ca32193d9955  # Anvil default account #8

FORGE_DEFAULT_PLATFORM_FEE_BPS_TESTNET=750
FORGE_DEFAULT_PLATFORM_FEE_BPS_MAINNET=750
FORGE_DEFAULT_PLATFORM_FEE_BPS_PREVIEW=750

FORGE_ERC8004_REPUTATION_REGISTRY_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
FORGE_ERC8004_REPUTATION_REGISTRY_MAINNET=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
# FORGE_ERC8004_REPUTATION_REGISTRY_PREVIEW: same address as _TESTNET -- a disposable
# chain clones the real Base Sepolia registry's bytecode onto itself at this exact
# address (see the facilitator section of docs/specs/agent-preview-environments-rfc.md),
# it is not redeployed, so there is no separate local address.
FORGE_ERC8004_REPUTATION_REGISTRY_PREVIEW=0x8004B663056A597Dffe9eCcC1965A193B7388713

FORGE_RPC_URL_PREVIEW=http://127.0.0.1:8545  # disposable Anvil chain; testnet/mainnet use the aliases below instead
FORGE_BASE_RPC_URL=https://mainnet.base.org
FORGE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
FORGE_ETHERSCAN_API_KEY=

# =============================================================================
# SMOKE TESTS (apps/backend/scripts/smoke-*.ts)
# =============================================================================

# Required for all smoke tests (or set DEV_PRIVATE_KEY as a single fallback):
# DEV_PRIVATE_KEY=0x...
# REQUESTER_PRIVATE_KEY=0x...
# WORKER_PRIVATE_KEY=0x...

# Required for smoke-ranked-payout (two-worker multi-winner test):
# WORKER_B_PRIVATE_KEY=0x...

# Required for smoke-evaluator (optional — if unset, requester acts as evaluator):
# EVALUATOR_PRIVATE_KEY=0x...

# For smoke tests that need the reward hook:
# WORKER_WITHDRAWAL_ADDRESS=0x...

# ---- DREAMS token reward hook (make deploy-reward-hook) ----
# Pricing is an admin-settable dreamsPerUsdc rate on the hook contract — no
# on-chain price oracle. Update FORGE_DREAMS_PER_USDC and redeploy (or call
# hook.setDreamsPerUsdc() directly) when the market price of DREAMS moves
# materially (rule of thumb: >20% move or weekly, whichever comes first).
#
# `make deploy-reward-hook <testnet|mainnet|preview>` resolves each var below as
# FORGE_X, falling back to FORGE_X_TESTNET / FORGE_X_MAINNET / FORGE_X_PREVIEW per
# network -- same pattern as FORGE_DIAMOND_ADDRESS_TESTNET/_MAINNET. ALWAYS set the
# suffixed form, never the bare form, or a value tuned for testnet will
# silently carry over into a mainnet deploy (and vice versa).
#
# preview needs no static config here: FORGE_DIAMOND_ADDRESS_PREVIEW and
# FORGE_PGTR_FORWARDER_PREVIEW are this run's own freshly deployed addresses
# (same "deploy output, not config input" reasoning as FORGE_USDC_TOKEN_ADDRESS_PREVIEW
# below), and every other var falls back to DeployRewardHookTestnet.s.sol's own
# defaults -- scripts/cloud-env-setup.sh wires all of this up automatically.
FORGE_PROTOCOL_TOKEN_MAINNET=0x176383016BB310C9f1C180DC6729d5E28104e602   # mainnet only; testnet deploys its own MockERC20
FORGE_DIAMOND_ADDRESS_TESTNET=0x0A24E9c3b9E31B8258329e187470ACc16497Cec7
FORGE_DIAMOND_ADDRESS_MAINNET=0xDDc6cC3e4D11c1f3527B867C7DAD4ED9869C33f7
FORGE_DREAMS_PER_USDC_TESTNET=347
FORGE_DREAMS_PER_USDC_MAINNET=347                   # REQUIRED: whole DREAMS per $1; scaled x1e18 by the deploy script
FORGE_BONUS_BPS_TESTNET=750
FORGE_BONUS_BPS_MAINNET=750                         # REQUIRED (mainnet): USD bonus intensity in bps, e.g. 750 = 7.5% of task value
FORGE_EPOCH_DURATION_TESTNET=604800
FORGE_EPOCH_DURATION_MAINNET=604800                 # 7 days
FORGE_GLOBAL_EPOCH_CAP_USD_TESTNET=100000000000
FORGE_GLOBAL_EPOCH_CAP_USD_MAINNET=5000000000       # $5,000/epoch (USDC base units, 6 dec) -- owner-adjustable post-deploy via EpochBudget.setGlobalCapUsd
FORGE_WORKER_CAP_USD_TESTNET=10000000000
FORGE_WORKER_CAP_USD_MAINNET=1000000000             # $1,000/worker/epoch -- owner-adjustable via setWorkerCapUsd
FORGE_REQUESTER_CAP_USD_TESTNET=50000000000
FORGE_REQUESTER_CAP_USD_MAINNET=1000000000          # $1,000/requester/epoch -- owner-adjustable via setRequesterCapUsd
FORGE_MAX_USD_PER_TASK_TESTNET=5000000000
FORGE_MAX_USD_PER_TASK_MAINNET=10000000             # $10/task -- owner-adjustable via setMaxUsdPerTask
FORGE_WORKER_SPLIT_BPS_TESTNET=8000
FORGE_WORKER_SPLIT_BPS_MAINNET=8000                 # Worker/requester split: 8000 = 80% worker, 20% requester
# FORGE_PGTR_FORWARDER_{TESTNET,MAINNET}: TaskMarketForwarder address. Its authorizedRelayer()
# is read on-chain and used as the reward hook's backend address -- not set directly, so the
# hook's trusted withdrawFor caller can never drift out of sync with the forwarder's relayer.
FORGE_PGTR_FORWARDER_TESTNET=0xE1c97c1660d743Aa666c41Bd47fc0c2Dd9Bea25f
FORGE_PGTR_FORWARDER_MAINNET=0x8884f95B69dd1581565633aEA85f9a9F7067144D
FORGE_INITIAL_VAULT_BALANCE_TESTNET=1000000000000000000000000  # testnet script mints a mock token and seeds it in the same deploy; no mainnet equivalent -- fund the vault separately (see PR docs)

# =============================================================================
# BACKEND
# =============================================================================

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskmarket:taskmarket@localhost:5432/taskmarket

CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
CONTRACT_ADDRESS=0x...
# FORWARDER_ADDRESS: address of the deployed TaskMarketForwarder contract
# See packages/contracts/script/Deploy.s.sol for deployment instructions
FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000
CONTRACT_DEPLOY_BLOCK=0
# Optional one-off task award repair bounds. Leave unset for normal startup.
# TASK_AWARDS_BACKFILL_FROM_BLOCK=123000
# TASK_AWARDS_BACKFILL_TO_BLOCK=124000
# TASK_AWARDS_BACKFILL_IGNORE_CHECKPOINT=true
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DEFAULT_PLATFORM_FEE_BPS=750
# RFC-0006 Tier 1 (docs/rfc/0006-submission-spam-free-allowance-pricing.md): free
# submissions per (worker, task) for bounty/benchmark tasks before x402 payment is
# required. Optional -- defaults to FREE_SUBMISSION_ALLOWANCE (currently 3,
# apps/backend/src/config/payments.ts) when unset. Smoke/sandbox environments raise this
# (scripts/cloud-env-setup.sh sets 1000) so ordinary multi-submission test coverage
# doesn't need x402Post just to keep submitting.
# SUBMISSION_FREE_ALLOWANCE=3
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
# Block where ERC8004 identity registry was first deployed (avoids scanning from genesis)
# Mainnet: 27600000  Testnet (Sepolia): 36304157
ERC8004_SEED_BLOCK=27600000
# EIP-712 domain name for USDC (must match the contract's name())
# Mainnet Base USDC: 'USD Coin'  Sepolia USDC: 'USDC'
USDC_DOMAIN_NAME="USD Coin"
SERVER_PRIVATE_KEY=0x...
CORS_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Railway normally contributes one trusted reverse-proxy hop. Set 0 for direct exposure.
TRUST_PROXY_HOPS=1
X402_FACILITATOR_URL=https://facilitator.daydreams.systems
X402_FACILITATOR_TOKEN=
PLATFORM_MASTER_KEY=
OFFICIAL_TASK_DROP_OWNER_ADDRESSES=
# Legal clickwrap remains off until counsel approves the checked-in bundle and
# replaces every bracketed entity/jurisdiction placeholder.
LEGAL_ENFORCEMENT_ENABLED=false
# Server-side Privy access-token verification. Never expose the secret to the web app.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Legal enforcement requires NEXT_PUBLIC_PRIVY_APP_ID below to match PRIVY_APP_ID.
# Optional: avoids fetching the app verification key on first use.
# PRIVY_JWT_VERIFICATION_KEY=
# DREAMS token reward hook — set after running `make deploy-reward-hook`
# DREAMS_HOOK_ADDRESS=0x...             # TaskTokenRewardHook contract address
# DREAMS_HOOK_SEED_BLOCK=0              # Block the hook was deployed at; indexer starts here for reward-hook events

# AWS (required in production)
AWS_REGION=us-east-1
AWS_S3_BUCKET=taskmarket-submissions
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# XMTP (optional)
# XMTP_ENABLED=false
# XMTP_POLICY_DEFAULT=open            # open | allowlist
# XMTP_STALE_INSTALLATION_MINUTES=60

# Email
# ---- agent-to-agent routing works with no config (direct DB insert) ----
# Required in production for external outbound delivery:
# OUTBOUND_EMAIL_WORKER_URL=https://taskmarket-email-worker.<subdomain>.workers.dev
#
EMAIL_DOMAIN=taskmarket.dev
WEB_APP_URL=http://localhost:3001
# Required in production (must match Cloudflare Email Worker secret):
EMAIL_WEBHOOK_SECRET=
#
# Local dev only — SMTP inbound server (Railway blocks port 25 in prod):
# SMTP_PORT=25
# SMTP_TLS_CERT=
# SMTP_TLS_KEY=

# Admin secret for the broadcast endpoint. Generate with: openssl rand -hex 32
# ADMIN_SECRET=

# Testnet overrides:
# CHAIN_ID=84532
# BASE_RPC_URL=https://sepolia.base.org
# USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
# ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713

# =============================================================================
# FRONTEND (Vite — VITE_ prefix)
# =============================================================================

VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=https://taskmarket.dev
VITE_TASK_MARKET_ADDRESS=0x...
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_CHAIN_ID=8453
VITE_EXPLORER_URL=https://basescan.org
VITE_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
VITE_WALLETCONNECT_PROJECT_ID=

# Testnet overrides:
# VITE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# VITE_CHAIN_ID=84532
# VITE_EXPLORER_URL=https://sepolia.basescan.org
# VITE_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e

# =============================================================================
# WEB APP (Next.js — everything NEXT_PUBLIC_, no exceptions)
# =============================================================================
#
# NEXT_PUBLIC_API_URL is the one true backend URL for this app -- Railway
# production is configured this way. Don't also set a bare TASKMARKET_API_URL
# here (next.config.ts checks it first if present, purely for local/CLI
# convenience); doing so in this file just creates two names for one thing.
# All values below are public by design (embedded in the client bundle), same
# as a Stripe publishable key -- safe to commit.

NEXT_PUBLIC_API_URL=https://api.taskmarket.dev
NEXT_PUBLIC_SITE_URL=https://taskmarket.dev
NEXT_PUBLIC_PLATFORM_FEE_BPS=750
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=

# Must match backend PRIVY_APP_ID when legal enforcement is enabled.
NEXT_PUBLIC_PRIVY_APP_ID=cmp6o0uzg006w0cl2g9aerklm
NEXT_PUBLIC_PRIVY_CLIENT_ID=client-WY6ZNcDvsqEwhA13vddpNVxw17AgkVtTcf1BLRdC3vWzh
NEXT_PUBLIC_PRIVY_FUNDING_ENV=production
# Enables Coinbase/fiat Add USDC flows after onramp approval is ready.
NEXT_PUBLIC_PRIVY_FIAT_ONBOARDING_ENABLED=false

# Testnet overrides:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_PRIVY_FUNDING_ENV=sandbox
