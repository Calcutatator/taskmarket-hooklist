{
  "name": "@taskmarket/html-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:check": "eslint src/ test/",
    "lint:write": "eslint src/ test/ --fix",
    "format:check": "prettier --check src/ test/ *.ts *.json",
    "format:write": "prettier --write src/ test/ *.ts *.json",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@taskmarket/eslint-config": "workspace:*",
    "@taskmarket/prettier-config": "workspace:*",
    "@types/node": "^25.6.2",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "prettier": "@taskmarket/prettier-config"
}
