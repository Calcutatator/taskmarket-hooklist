{
  "name": "@taskmarket/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:check": "eslint src/",
    "lint:write": "eslint src/ --fix",
    "format:check": "prettier --check src/",
    "format:write": "prettier --write src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@taskmarket/eslint-config": "workspace:*",
    "@taskmarket/prettier-config": "workspace:*",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "prettier": "@taskmarket/prettier-config"
}
